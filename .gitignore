# vscode ignore
.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/
Stewart Platform Code\.vscode/

# SolidWorks Backup and Temp Files
*.sldprt~*
*.sldasm~*
*.slddrw~*
*.swp
*.bak
*.tmp


~$*.sldprt
~$*.sldasm
~$*.slddrw
~$*.sld

# For systems with case-sensitive (SolidWorks uses both)
~$*.SLDPRT
~$*.SLDASM
~$*.SLDDRW
~$*.SLD

SolidWorks/~$*.SLDPRT
SolidWorks/~$*.SLDASM
SolidWorks/~$*.SLDDRW
SolidWorks/~$*.SLD

# SolidWorks PDM Cache
swpdm/

# Simulation Results
*.cwr
*.out
*.fld

# Toolbox and Libraries (if not shared)
Toolbox/
DesignLibrary/

# OS-specific junk files
DS_Store
Thumbs.db

#Pycache
__pycache__/